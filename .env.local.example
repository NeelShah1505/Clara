# ─────────────────────────────────────────────────────────────────────────────
# Firebase CLIENT SDK  (NEXT_PUBLIC_ prefix — safe to expose to browser)
# These are NOT secret — Firebase's design intentionally makes them public.
# Security is enforced by Firestore/Storage rules and App Check.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# App Check — reCAPTCHA v3 site key (public key, safe to expose)
NEXT_PUBLIC_RECAPTCHA_V3_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY

# ─────────────────────────────────────────────────────────────────────────────
# Firebase ADMIN SDK  (server-side only — NEVER expose to the browser)
# Store this as a JSON string (the full service account JSON on one line).
# In production use Google Secret Manager instead of .env.local.
# ─────────────────────────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID",...}

# ─────────────────────────────────────────────────────────────────────────────
# Session cookie secret (random 32+ char string, server-side only)
# Generate: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
SESSION_COOKIE_SECRET=YOUR_RANDOM_SECRET_HERE

# ─────────────────────────────────────────────────────────────────────────────
# Emulator overrides (uncomment when running firebase emulators locally)
# ─────────────────────────────────────────────────────────────────────────────
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
