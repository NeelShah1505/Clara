{
  "compilerOptions": {
    "module":           "commonjs",
    "moduleResolution": "node",
    "noImplicitAny":    true,
    "noImplicitReturns": true,
    "outDir":           "lib",
    "rootDir":          "src",
    "sourceMap":        true,
    "strict":           true,
    "target":           "es2021",
    "lib":              ["es2021"],
    "esModuleInterop":  true,
    "skipLibCheck":     true
  },
  "compileOnSave": true,
  "include":  ["src/**/*"],
  "exclude":  ["node_modules"]
}
