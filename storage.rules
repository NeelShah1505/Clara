rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ────────────────────────────────────────────────────────────────────────
    // USER FILES (receipts, profile pictures, exports)
    //
    // Mirrors the Firestore isolation rule: users can only access their own
    // files. Email verification required (security.md §3, §7).
    // ────────────────────────────────────────────────────────────────────────
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId)
                         && isEmailVerified()
                         && isValidUpload();
    }

    // ────────────────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ────────────────────────────────────────────────────────────────────────

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    /// Basic upload guards enforced at the rules level.
    /// Server-side validation (Cloud Function trigger) does deeper checks:
    /// file type sniffing, EXIF strip, virus scan — see security.md §7.
    function isValidUpload() {
      return request.resource == null   // allow deletes
          || (
            // Max 10 MB per file
            request.resource.size <= 10 * 1024 * 1024
            // Only allow image and PDF uploads from client
            && request.resource.contentType.matches('image/.*|application/pdf')
          );
    }
  }
}
